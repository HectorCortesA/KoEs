CREATE TABLE DictionaryItemEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    wordSpanish TEXT NOT NULL,
    wordCoreano TEXT NOT NULL,
    romanization TEXT NOT NULL,
    pronunciation TEXT NOT NULL,
    categoria TEXT NOT NULL,
    subcategoria TEXT NOT NULL,
    ejemploSpanish TEXT NOT NULL,
    ejemploKoreano TEXT NOT NULL
);

-- Consultas de la base de datos

insertWord:
INSERT INTO DictionaryItemEntity (
    wordSpanish,
    wordCoreano,
    romanization,
    pronunciation,
    categoria,
    subcategoria,
    ejemploSpanish,
    ejemploKoreano
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT *
FROM DictionaryItemEntity;

selectAllPaginated:
SELECT *
FROM DictionaryItemEntity
LIMIT :limit OFFSET :offset;

searchWords:
SELECT *
FROM DictionaryItemEntity
WHERE wordSpanish LIKE ('%' || :query || '%')
   OR wordCoreano LIKE ('%' || :query || '%')
   OR romanization LIKE ('%' || :query || '%')
   OR pronunciation LIKE ('%' || :query || '%')
   OR subcategoria LIKE ('%' || :query || '%')
   OR categoria LIKE ('%' || :query || '%');

searchWordsPaginated:
SELECT *
FROM DictionaryItemEntity
WHERE wordSpanish LIKE ('%' || :query || '%')
   OR wordCoreano LIKE ('%' || :query || '%')
   OR romanization LIKE ('%' || :query || '%')
   OR pronunciation LIKE ('%' || :query || '%')
   OR subcategoria LIKE ('%' || :query || '%')
   OR categoria LIKE ('%' || :query || '%')
LIMIT :limit OFFSET :offset;

countWords:
SELECT COUNT(*)
FROM DictionaryItemEntity;

deleteAll:
DELETE FROM DictionaryItemEntity;

getCategories:
SELECT DISTINCT categoria FROM DictionaryItemEntity;

getRandomByCategory:
SELECT * FROM DictionaryItemEntity
WHERE categoria = :categoria
ORDER BY RANDOM()
LIMIT 1;

getRandomAll:
SELECT * FROM DictionaryItemEntity
ORDER BY RANDOM()
LIMIT 1;


