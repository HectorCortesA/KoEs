-- Este archivo describe el esquema más reciente para crear una base de datos nueva desde cero.
-- No contiene registros iniciales; estos se manejan en los archivos de migración (.sqm).

CREATE TABLE DictionaryItemEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    wordSpanish TEXT NOT NULL,
    wordCoreano TEXT NOT NULL,
    romanization TEXT NOT NULL,
    pronunciation TEXT NOT NULL,
    tipo TEXT NOT NULL,
    categoria TEXT NOT NULL,
    definicion TEXT NOT NULL,
    ejemploSpanish TEXT NOT NULL,
    ejemploKoreano TEXT NOT NULL
);

-- Consultas de la base de datos

insertWord:
INSERT INTO DictionaryItemEntity (
    wordSpanish,
    wordCoreano,
    romanization,
    pronunciation,
    tipo,
    categoria,
    definicion,
    ejemploSpanish,
    ejemploKoreano
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT *
FROM DictionaryItemEntity;

selectAllPaginated:
SELECT *
FROM DictionaryItemEntity
LIMIT :limit OFFSET :offset;

searchWords:
SELECT *
FROM DictionaryItemEntity
WHERE wordSpanish LIKE ('%' || :query || '%')
   OR wordCoreano LIKE ('%' || :query || '%')
   OR romanization LIKE ('%' || :query || '%')
   OR pronunciation LIKE ('%' || :query || '%')
   OR tipo LIKE ('%' || :query || '%')
   OR categoria LIKE ('%' || :query || '%');

searchWordsPaginated:
SELECT *
FROM DictionaryItemEntity
WHERE wordSpanish LIKE ('%' || :query || '%')
   OR wordCoreano LIKE ('%' || :query || '%')
   OR romanization LIKE ('%' || :query || '%')
   OR pronunciation LIKE ('%' || :query || '%')
   OR tipo LIKE ('%' || :query || '%')
   OR categoria LIKE ('%' || :query || '%')
LIMIT :limit OFFSET :offset;

countWords:
SELECT COUNT(*)
FROM DictionaryItemEntity;

deleteAll:
DELETE FROM DictionaryItemEntity;




